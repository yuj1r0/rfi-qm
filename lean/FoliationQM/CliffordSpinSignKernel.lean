module
public import FoliationQM.CliffordSpinUniversalCover
public import FoliationQM.CliffordSpinPolarAction
public import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# The genuine Clifford sign kernel as the cyclic group of order two

Source scope: the two-sign kernel and monodromy component of the v13
Spin/Lorentz identification in `prop:takabayasi` and `eq:tetrad_rotor_map`.
The kernel is the actual subgroup of the original physical Clifford
Lorentz homomorphism, with its existing subtype topology and group law.
Its two elements are the identity and the literal negative Clifford unit.

The actual covering proves discreteness and cardinality two. The kernel
is central in genuine Spin and is generated by that specified negative
unit. Its multiplicative equivalence with ZMod 2 sends precisely this
generator to the nonzero class. No abstract group of the same size replaces
the physical kernel, and no fundamental-group or global-section claim
is assumed in constructing the equivalence.
-/

@[expose] public section
noncomputable section
open scoped Topology
namespace FoliationQM.CliffordSpinSignKernel
open CliffordSpinMap CliffordSpinLorentz CliffordSpinCovering LorentzMatrixGroup

/-- The actual kernel of the original physical Clifford Spin-to-Lorentz homomorphism. -/
abbrev Kernel := lorentzHom.ker

/-- The generator is the genuine negative Clifford unit, with its actual kernel membership proved. -/
def generator : Kernel :=
  ⟨CliffordSpinEquivalence.negativeOne, (lorentzHom_eq_one_iff _).mpr (Or.inr rfl)⟩

/-- The distinguished kernel generator has exactly the original negative Clifford Spin value. -/
theorem generator_val : generator.val = CliffordSpinEquivalence.negativeOne := rfl

/-- The distinguished genuine negative kernel generator is not the identity. -/
theorem generator_ne_one : generator ≠ 1 := by
  intro he
  exact CliffordSpinEquivalence.negativeOne_ne_one (congrArg Subtype.val he)

/-- Every actual kernel element is the identity or the specified genuine negative Clifford generator. -/
theorem eq_one_or_generator (s : Kernel) : s = 1 ∨ s = generator := by
  rcases (lorentzHom_eq_one_iff s.val).mp s.property with hs | hs
  · exact Or.inl (Subtype.ext hs)
  · exact Or.inr (Subtype.ext hs)

/-- The actual Clifford kernel contains exactly two elements, as the physical Lorentz fiber over the identity. -/
theorem kernel_card : Nat.card Kernel = 2 :=
  lorentz_fiber_card (1 : ProperFutureLorentz)

/-- The actual kernel retains its inherited discrete topology, proved from the genuine covering fiber over the identity. -/
instance instDiscreteTopologyKernel : DiscreteTopology Kernel :=
  (lorentzHom_isCoveringMap (1 : ProperFutureLorentz)).discreteTopology_fiber

/-- Every element of the actual Clifford sign kernel commutes with every genuine Spin element. -/
theorem kernel_mul_comm (k : Kernel) (s : Spin) : k.val * s = s * k.val := by
  rcases eq_one_or_generator k with rfl | rfl
  · simp
  · exact CliffordSpinPolarAction.negativeOne_mul_comm s

/-- The physical Clifford sign kernel is an actual central subgroup of Spin. -/
theorem kernel_le_center : Kernel ≤ Subgroup.center Spin := by
  intro k hk
  rw [Subgroup.mem_center_iff]
  intro s
  exact (kernel_mul_comm ⟨k, hk⟩ s).symm

/-- Commutativity of the actual kernel is supplied as a property without replacing its inherited subgroup group structure. -/
instance instIsMulCommutativeKernel : IsMulCommutative Kernel :=
  ⟨⟨fun a b => Subtype.ext (kernel_mul_comm a b.val)⟩⟩

/-- Every actual kernel element is an integer power of the specified negative Clifford unit. -/
theorem generator_generates (s : Kernel) : s ∈ Subgroup.zpowers generator := by
  rcases eq_one_or_generator s with rfl | rfl
  · exact Subgroup.one_mem _
  · exact Subgroup.mem_zpowers _

/-- The specified negative Clifford generator has exact order two in the actual physical kernel. -/
theorem generator_orderOf : orderOf generator = 2 :=
  (orderOf_eq_card_of_forall_mem_zpowers generator_generates).trans kernel_card

/-- The genuine physical sign kernel is multiplicatively equivalent to ZMod 2 with its specified negative Clifford generator normalized to the nonzero class. -/
def kernelEquivZModTwo : Kernel ≃* Multiplicative (ZMod 2) :=
  (zmodMulEquivOfGenerator generator_generates kernel_card).symm

/-- The actual negative Clifford kernel generator maps to the nonzero ZMod 2 class. -/
theorem kernelEquivZModTwo_generator :
    kernelEquivZModTwo generator = Multiplicative.ofAdd (1 : ZMod 2) :=
  zmodMulEquivOfGenerator_symm_apply_generator generator_generates kernel_card

/-- The inverse cyclic identification sends the nonzero class to the specified genuine Clifford kernel generator. -/
theorem kernelEquivZModTwo_symm_one :
    kernelEquivZModTwo.symm (Multiplicative.ofAdd (1 : ZMod 2)) = generator :=
  zmodMulEquivOfGenerator_apply_ofAdd_one generator_generates kernel_card

/-- The inverse identification of the nonzero class has precisely the actual negative Clifford Spin value. -/
theorem kernelEquivZModTwo_symm_one_val :
    (kernelEquivZModTwo.symm (Multiplicative.ofAdd (1 : ZMod 2))).val =
      CliffordSpinEquivalence.negativeOne := by
  rw [kernelEquivZModTwo_symm_one, generator_val]

/-- The identity of the actual physical sign kernel maps to the zero additive class. -/
theorem kernelEquivZModTwo_one :
    kernelEquivZModTwo 1 = Multiplicative.ofAdd (0 : ZMod 2) :=
  kernelEquivZModTwo.map_one

end FoliationQM.CliffordSpinSignKernel
