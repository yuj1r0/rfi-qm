module

public import FoliationQM.LatticeLagHamiltonian

/-!
# Complex residual of the regularized polar lattice

For the signed, replicated Neumann lattice in v13 lines 215–229, the complex
velocity reconstructed from the two real rates equals the finite Schrödinger
velocity plus an explicit phase-rotated radial term. At a node the term
has its full radial coefficient, while away from nodes its fractional
weight is bounded by the squared ratio of regulator width to amplitude.
-/

@[expose] public section
noncomputable section
namespace FoliationQM.LatticeSchrodingerResidual

open LatticeConservation LatticeNeumannHamiltonian LatticeComplexEnergy
open LatticeLagHamiltonian LatticeClockRegularization LatticePolarStencil

/-- Schrödinger velocity generated by the physical-frequency Neumann Hamiltonian. -/
def schrodinger {n : ℕ} (p : MassiveParameters) (h : ℝ) (V : Fin n → ℝ)
    (z : Fin n → ℂ) (i : Fin n) : ℂ :=
  -Complex.I * frequency p h V z i

/-- Complex source velocity in excess of the exact linear Neumann velocity. -/
def residual {n : ℕ} (p : MassiveParameters) (h ε : ℝ) (R φ : Fin n → ℝ)
    (i : Fin n) : ℂ :=
  phase (φ i) * (-Complex.I) *
    Complex.ofReal ((p.ellC*p.c/(2*h^2)) * defectFraction ε (R i) * radial R φ i)

/-- On the regular domain, the two source rates reconstruct the Schrödinger
velocity plus the explicit local radial residual, including at regularized nodes. -/
theorem velocity_split {n : ℕ} (p : MassiveParameters) (h ε : ℝ)
    (R φ V : Fin n → ℝ) (i : Fin n) (hn : R i ≠ 0 ∨ ε ≠ 0) :
    phase (φ i) * ((sourceAmplitudeRHS p.ellC p.c h R φ i : ℂ) +
      Complex.I * ((R i * (p.c/p.ellC) * lagRate p h ε R φ V i : ℝ) : ℂ)) =
      schrodinger p h V (wave R φ) i + residual p h ε R φ i := by
  have hd := congrArg (phase (φ i) * ·) (dephase_dimless p h R φ V i)
  rw [← mul_assoc, mul_comm (phase (φ i)) (star (phase (φ i))), unit_phase, one_mul] at hd
  have ha : sourceAmplitudeRHS p.ellC p.c h R φ i =
      -(p.omega0 * (p.ellC^2/(2*h^2))) * angular R φ i := by
    rw [omega0_mul_kinetic]
    rfl
  have hc := mul_reciprocal_add_defectFraction ε (R i) hn
  have hl : R i * (p.c/p.ellC) * lagRate p h ε R φ V i =
      p.omega0 * ((p.ellC^2/(2*h^2)) * radial R φ i - R i * (V i/(p.m*p.c^2))) -
        (p.ellC*p.c/(2*h^2)) * defectFraction ε (R i) * radial R φ i := by
    rw [lagRate, ← omega0_eq_clock_scale, ← omega0_mul_kinetic]
    linear_combination (p.omega0 * (p.ellC^2/(2*h^2)) * radial R φ i) * hc
  rw [schrodinger, frequency, hd, residual, ha, hl, ← omega0_mul_kinetic]
  generalize p.ellC^2/(2*h^2) = k
  generalize V i/(p.m*p.c^2) = w
  push_cast
  ring_nf
  simp [Complex.I_sq]

/-- The norm is the physical kinetic coefficient times the lost fraction and
the absolute radial stencil, independently of the local choice of phase. -/
theorem norm_residual {n : ℕ} (p : MassiveParameters) (h ε : ℝ)
    (R φ : Fin n → ℝ) (i : Fin n) :
    ‖residual p h ε R φ i‖ =
      (p.ellC*p.c/(2*h^2)) * defectFraction ε (R i) * |radial R φ i| := by
  have hk : 0 ≤ p.ellC*p.c/(2*h^2) :=
    div_nonneg (mul_nonneg (ClockScales.ellC_pos p).le p.c_pos.le) (by positivity)
  simp only [residual, phase, norm_mul, Complex.norm_exp_ofReal_mul_I, norm_neg,
    Complex.norm_I, Complex.norm_real, Real.norm_eq_abs, one_mul,
    abs_of_nonneg hk, abs_of_nonneg (defectFraction_mem_unitInterval ε (R i)).1]

/-- At distance at least `δ` from a node the residual is bounded by ε²/δ²
times the physical kinetic coefficient and the local absolute radial stencil. -/
theorem norm_residual_le_away {n : ℕ} (p : MassiveParameters) (h ε δ : ℝ)
    (R φ : Fin n → ℝ) (i : Fin n) (hδ : 0 < δ) (hi : δ ≤ |R i|) :
    ‖residual p h ε R φ i‖ ≤ (p.ellC*p.c/(2*h^2)) * (ε^2/δ^2) * |radial R φ i| := by
  rw [norm_residual]
  exact mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_left (defectFraction_le_of_abs_ge ε (R i) δ hδ hi)
      (div_nonneg (mul_nonneg (ClockScales.ellC_pos p).le p.c_pos.le) (by positivity)))
    (abs_nonneg _)

/-- The residual formula has zero numerator at zero regulator width. -/
theorem residual_zero_width {n : ℕ} (p : MassiveParameters) (h : ℝ)
    (R φ : Fin n → ℝ) (i : Fin n) : residual p h 0 R φ i = 0 := by
  simp [residual, defectFraction]

/-- At a node of a regularized trajectory the entire radial kinetic term is lost. -/
theorem residual_at_node {n : ℕ} (p : MassiveParameters) (h ε : ℝ)
    (R φ : Fin n → ℝ) (i : Fin n) (hε : ε ≠ 0) (hi : R i = 0) :
    residual p h ε R φ i =
      phase (φ i) * (-Complex.I) * Complex.ofReal ((p.ellC*p.c/(2*h^2)) * radial R φ i) := by
  rw [residual, hi, defectFraction_at_node ε hε, mul_one]

/-- With positive spacing and nonzero width the nodal residual vanishes
exactly when the radial Neumann stencil vanishes. -/
theorem residual_at_node_eq_zero_iff {n : ℕ} (p : MassiveParameters) {h ε : ℝ}
    (R φ : Fin n → ℝ) (i : Fin n) (hh : 0 < h) (hε : ε ≠ 0) (hi : R i = 0) :
    residual p h ε R φ i = 0 ↔ radial R φ i = 0 := by
  have hk : 0 < p.ellC*p.c/(2*h^2) :=
    div_pos (mul_pos (ClockScales.ellC_pos p) p.c_pos) (by positivity)
  rw [← norm_eq_zero, norm_residual, hi, defectFraction_at_node ε hε, mul_one]
  simp [hk.ne']

end FoliationQM.LatticeSchrodingerResidual
