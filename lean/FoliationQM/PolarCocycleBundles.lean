module
public import FoliationQM.PolarTransitionCocycle

/-!
# Actual polar and regular-spinor bundles from supplied transition cocycles

Source: the local quotient-bundle interpretation in v13 `prop:takabayasi`.
The supplied open cover and smooth determinant-one transition cocycle define
two actual Mathlib `FiberBundleCore` objects, using the independently proved
polar quotient action and represented spinor action. Their total spaces use
exactly the topologies generated by the core trivializations.

Actual polar realization intertwines those coordinate changes. Its pointwise
fiber map is therefore a genuine base-preserving homeomorphism between the
two total spaces, as proved in their actual local trivializations. The literal
polar formula and continuity of dependent section graphs are retained.
These results are conditional on the supplied concrete cocycle. They do not
identify an abstract spacetime Spin structure, select a global individual
representative, or install a smooth atlas on either total space.
-/

@[expose] public section
noncomputable section
set_option backward.isDefEq.respectTransparency false
open scoped Topology Manifold Matrix.Norms.Operator
open Bundle Set
namespace FoliationQM.PolarCocycleBundles
open PolarTransitionCocycle PolarSignQuotient SourcePolarProductQuotient

section CoreContinuity
variable {ι B F G : Type*} [TopologicalSpace B] [TopologicalSpace F] [TopologicalSpace G]
variable (Z : FiberBundleCore ι B F) (W : FiberBundleCore ι B G)
variable (h : F ≃ₜ G) (hbase : ∀ i, W.baseSet i = Z.baseSet i)
  (hindex : W.indexAt = Z.indexAt)
  (heq : ∀ i j x v, h (Z.coordChange i j x v) = W.coordChange i j x (h v))

private def mappedTotal (p : Z.TotalSpace) : W.TotalSpace := ⟨p.proj, h p.2⟩

include hindex heq in
private theorem mappedTotal_triv (i : ι) (p : Z.TotalSpace) :
    W.localTriv i (mappedTotal Z W h p) =
      (Z.localTriv i p |>.1, h (Z.localTriv i p).2) := by
  simp only [FiberBundleCore.localTriv_apply, mappedTotal, hindex]
  exact congrArg (Prod.mk p.proj) (heq (Z.indexAt p.proj) i p.proj p.2).symm

include hbase hindex heq in
private theorem continuous_mappedTotal : Continuous (mappedTotal Z W h) := by
  apply continuous_iff_continuousAt.mpr
  intro p
  let i := Z.indexAt p.proj
  apply (W.localTriv i).continuousAt_of_comp_left
  · exact Z.continuous_proj.continuousAt
  · change p.proj ∈ W.baseSet i
    rw [hbase]
    exact Z.mem_baseSet_at p.proj
  · have hp : p ∈ (Z.localTriv i).source := Z.mem_baseSet_at p.proj
    have hc := (Z.localTriv i).toOpenPartialHomeomorph.continuousAt hp
    have hh : Continuous (fun q : B × F => (q.1, h q.2)) :=
      continuous_fst.prodMk (h.continuous.comp continuous_snd)
    convert hh.continuousAt.comp hc using 1
    exact funext (mappedTotal_triv Z W h hindex heq i)

end CoreContinuity

variable {E H B : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  [TopologicalSpace B] [ChartedSpace H B] {ι : Type*} {n : WithTop ℕ∞}
  (D : Data I B ι n)

/-- The actual polar fiber-bundle core built from the supplied cover and actual density/frame transition action. -/
def polarCore : FiberBundleCore ι B DensityFrameManifold.Product where
  baseSet i := D.domain i
  isOpen_baseSet i := (D.domain i).isOpen
  indexAt := indexAt D
  mem_baseSet_at := mem_domain_indexAt D
  coordChange := polarChange D
  coordChange_self := polarChange_self D
  continuousOn_coordChange i j := (contMDiffOn_polarChange D i j).continuousOn
  coordChange_comp i j k x hx v := polarChange_comp D i j k x hx.1.1 hx.1.2 hx.2 v

/-- The actual regular-spinor fiber-bundle core built from the same supplied cover and represented matrix transitions. -/
def spinorCore : FiberBundleCore ι B RegularSpinor where
  baseSet i := D.domain i
  isOpen_baseSet i := (D.domain i).isOpen
  indexAt := indexAt D
  mem_baseSet_at := mem_domain_indexAt D
  coordChange := spinorChange D
  coordChange_self := spinorChange_self D
  continuousOn_coordChange i j := (contMDiffOn_spinorChange D i j).continuousOn
  coordChange_comp i j k x hx v := spinorChange_comp D i j k x hx.1.1 hx.1.2 hx.2 v

/-- The actual total space of the polar cocycle bundle, with its core-generated topology. -/
abbrev PolarTotal := (polarCore D).TotalSpace
/-- The actual total space of the regular-spinor cocycle bundle, with its core-generated topology. -/
abbrev SpinorTotal := (spinorCore D).TotalSpace

/-- Actual fiberwise polar realization is a base-preserving homeomorphism of the two cocycle bundle total spaces. -/
def totalRealization : PolarTotal D ≃ₜ SpinorTotal D where
  toFun p := ⟨p.proj, productRegularHomeomorph p.2⟩
  invFun p := ⟨p.proj, productRegularHomeomorph.symm p.2⟩
  left_inv p := by
    cases p
    simp
  right_inv p := by
    cases p
    simp
  continuous_toFun := by
    exact continuous_mappedTotal (polarCore D) (spinorCore D)
      productRegularHomeomorph (fun _ => rfl) rfl (change_equivariant D)
  continuous_invFun := by
    apply continuous_mappedTotal (spinorCore D) (polarCore D)
      productRegularHomeomorph.symm (fun _ => rfl) rfl
    intro i j x v
    apply productRegularHomeomorph.injective
    simpa only [Homeomorph.apply_symm_apply, polarCore, spinorCore] using
      (change_equivariant D i j x (productRegularHomeomorph.symm v)).symm

/-- The total-space homeomorphism acts by the actual polar realization on the fiber at the same base point. -/
theorem totalRealization_apply (p : PolarTotal D) :
    totalRealization D p = ⟨p.proj, productRegularHomeomorph p.2⟩ := rfl

/-- The inverse total-space homeomorphism uses the actual quotient-valued polar reconstruction in each fiber. -/
theorem totalRealization_symm_apply (p : SpinorTotal D) :
    (totalRealization D).symm p = ⟨p.proj, productRegularHomeomorph.symm p.2⟩ := rfl

/-- The actual total-space polar realization preserves the bundle projection. -/
theorem totalRealization_proj (p : PolarTotal D) :
    (totalRealization D p).proj = p.proj := rfl

/-- The actual total-space inverse reconstruction preserves the bundle projection. -/
theorem totalRealization_symm_proj (p : SpinorTotal D) :
    ((totalRealization D).symm p).proj = p.proj := rfl

/-- In every actual core trivialization, total-space realization is the identity on the base paired with the actual polar homeomorphism. -/
theorem localTriv_totalRealization (i : ι) (p : PolarTotal D) :
    (spinorCore D).localTriv i (totalRealization D p) =
      ((polarCore D).localTriv i p |>.1,
        productRegularHomeomorph ((polarCore D).localTriv i p).2) := by
  exact mappedTotal_triv (polarCore D) (spinorCore D) productRegularHomeomorph
    rfl (change_equivariant D) i p

/-- The inverse total-space map has the corresponding exact local-trivialization formula with the actual inverse polar homeomorphism. -/
theorem localTriv_totalRealization_symm (i : ι) (p : SpinorTotal D) :
    (polarCore D).localTriv i ((totalRealization D).symm p) =
      ((spinorCore D).localTriv i p |>.1,
        productRegularHomeomorph.symm ((spinorCore D).localTriv i p).2) := by
  apply Prod.ext
  · rfl
  · apply productRegularHomeomorph.injective
    change productRegularHomeomorph (polarChange D (indexAt D p.proj) i p.proj
      (productRegularHomeomorph.symm p.2)) =
        productRegularHomeomorph (productRegularHomeomorph.symm
          (spinorChange D (indexAt D p.proj) i p.proj p.2))
    simpa only [Homeomorph.apply_symm_apply] using
      change_equivariant D (indexAt D p.proj) i p.proj
        (productRegularHomeomorph.symm p.2)

/-- The actual projection of the polar cocycle bundle is continuous in its genuine core topology. -/
theorem continuous_polar_proj : Continuous (polarCore D).proj :=
  (polarCore D).continuous_proj

/-- The actual projection of the regular-spinor cocycle bundle is continuous in its genuine core topology. -/
theorem continuous_spinor_proj : Continuous (spinorCore D).proj :=
  (spinorCore D).continuous_proj

/-- The actual polar cocycle bundle projection is an open map. -/
theorem isOpenMap_polar_proj : IsOpenMap (polarCore D).proj :=
  (polarCore D).isOpenMap_proj

/-- The actual regular-spinor cocycle bundle projection is an open map. -/
theorem isOpenMap_spinor_proj : IsOpenMap (spinorCore D).proj :=
  (spinorCore D).isOpenMap_proj

/-- In a selected fiber coordinate, the total-space homeomorphism agrees exactly with the source polar spinor expression on a real-angle representative. -/
theorem totalRealization_mk_real (x : B)
    (rho : PolarAmplitudeTopology.PositiveDensity) (beta : ℝ)
    (A : SourcePolarDatum.SpecialLinearMatrix) :
    (totalRealization D ⟨x, (rho, Quotient.mk frameSetoid
      ((beta : ChiralAngleCircle.Angle), A))⟩).snd.val =
      PolarSpinorBilinears.polarSpinor rho beta (SpecialLinearSpin.spin A) :=
  DensityFrameManifold.productRegularDiffeomorph_mk_real n rho beta A

/-- An actual dependent polar section has a continuous total-space graph exactly when its realized regular-spinor section does. -/
theorem continuous_sectionGraph_iff
    (s : ∀ x : B, (polarCore D).Fiber x) :
    Continuous (fun x => (⟨x, s x⟩ : PolarTotal D)) ↔
      Continuous (fun x => (⟨x, productRegularHomeomorph (s x)⟩ : SpinorTotal D)) := by
  constructor
  · intro hs
    exact (totalRealization D).continuous.comp hs
  · intro hs
    have h := (totalRealization D).symm.continuous.comp hs
    simpa only [Function.comp_def, totalRealization_symm_apply,
      Homeomorph.symm_apply_apply] using h

end FoliationQM.PolarCocycleBundles
