/-! Enumerate by originating module, not public-name prefix, to include private
and compiler-generated supporting declarations. Lean 4.35 collectAxioms uses
the kernel environment and imported transitive axiom metadata. This command
writes reports; it is not used to construct mathematical proofs. -/
set_option pp.proofs true
set_option pp.universes true

open Lean Elab Command Meta in
run_elab do
  let env ← getEnv
  let mut names : Array Name := #[]
  for (name, _) in env.constants do
    if let some idx := env.getModuleIdxFor? name then
      let mod := env.header.moduleNames[idx.toNat]!
      if mod == `FoliationQM || (`FoliationQM).isPrefixOf mod then
        names := names.push name
  names := names.qsort Name.lt
  if names.isEmpty then throwError "No project declarations found"
  let allowed : Array Name := #[`propext, `Classical.choice, `Quot.sound]
  let mut rows : Array Json := #[]
  for name in names do
    let axs ← collectAxioms name
    for ax in axs do
      unless allowed.contains ax do
        throwError "Forbidden axiom {ax} in {name}"
    let some info := env.find? name | throwError "Missing declaration {name}"
    if info matches .axiomInfo _ then throwError "Project axiom declaration: {name}"
    let typ ← Meta.ppExpr info.type
    let kind := match info with
      | .thmInfo _ => "theorem"
      | .defnInfo _ => "definition"
      | .opaqueInfo _ => "opaque"
      | .inductInfo _ => "inductive"
      | .ctorInfo _ => "constructor"
      | .recInfo _ => "recursor"
      | _ => "other"
    let idx := (env.getModuleIdxFor? name).get!
    rows := rows.push <| Json.mkObj [
      ("name", toJson name.toString),
      ("module", toJson env.header.moduleNames[idx.toNat]!.toString),
      ("kind", toJson kind), ("type", toJson typ.pretty),
      ("axioms", toJson (axs.map Name.toString))]
  IO.FS.writeFile "docs/axiom-audit.json" (Json.pretty (toJson rows) ++ "\n")
  logInfo m!"AXIOM AUDIT PASS: {names.size} project declarations; allowed axioms only."
